# Local SQLite file (relative to prisma/schema.prisma). Docker uses file:/data/inventory.db on a volume.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Where GRN receipt uploads are stored (default ./uploads)
UPLOAD_DIR=./uploads

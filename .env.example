# The app database: MongoDB (Atlas or a self-hosted replica set; Prisma needs a replica set for transactions).
# Include the database name after the host:
#   mongodb+srv://<username>:<password>@<cluster-host>/spring_inventory?retryWrites=true&w=majority
# URL-encode special characters in the password (@ : / ? # %).
DATABASE_URL=""
AUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true
# Where GRN receipt / PO document uploads are stored (default ./uploads)
UPLOAD_DIR=./uploads
# Optional: AI reading of PO documents
# ANTHROPIC_API_KEY=""
# PO_OCR_MODEL="claude-opus-5-5"

# Only for the one-off copy from the old local database (prisma/copy-sqlite-to-mongo.ts):
# SQLITE_URL="file:../dev.db"
